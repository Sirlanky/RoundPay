EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# Use anon public (eyJ...) or publishable key (sb_publishable_...) from Project Settings → API
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key
EXPO_PUBLIC_PAYSTACK_PUBLIC_KEY=pk_test_xxxxxxxx

# Push notifications (Expo) — run `npx eas init` to create a project, then paste the project ID here
# EXPO_PUBLIC_EAS_PROJECT_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# Dev: auto guest sign-in on launch (optional)
# EXPO_PUBLIC_SKIP_AUTH=true

# Paystack: payouts (bank transfers) are always used when configured.
# Set to true only if members should pay contributions by card in the app.
# EXPO_PUBLIC_PAYSTACK_COLLECT_CONTRIBUTIONS=true

# Prisma / local CLI only — never use EXPO_PUBLIC_* for these (not bundled in the app)
# Shared pooler (eu-west-1). Replace [YOUR-PASSWORD] from Supabase → Project Settings → Database
DATABASE_URL="postgresql://postgres.dolcajrcjhsfpyxzwtjk:[YOUR-PASSWORD]@aws-0-eu-west-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.dolcajrcjhsfpyxzwtjk:[YOUR-PASSWORD]@aws-0-eu-west-1.pooler.supabase.com:5432/postgres"

# Supabase Edge Functions only (set in Supabase dashboard secrets):
# PAYSTACK_SECRET_KEY=sk_test_xxxxxxxx
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
